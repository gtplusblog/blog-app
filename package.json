{
  "name": "gtplusblog-blog-app",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.7.0",
  "description": "手机端 Hugo 博客写作 App（PWA）：新建/编辑文章、分类标签、Markdown 正文，直连 GitHub 提交到 gtplusblog.github.io",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:lan": "vite preview --host",
    "serve": "node tools/serve.mjs",
    "test": "tsc -p tsconfig.test.json && node --test \"tools/**/*.test.mjs\"",
    "icons": "python tools/make_icons.py"
  },
  "dependencies": {
    "@codemirror/commands": "^6.9.0",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language": "^6.11.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@lezer/highlight": "^1.2.1",
    "idb-keyval": "^6.2.2",
    "katex": "^0.16.25",
    "markdown-it": "^14.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.1.0"
  }
}
